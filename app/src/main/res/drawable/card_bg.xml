<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- État focalisé (D-Pad sur TV) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#2A2A45" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
                <shape>
                    <stroke android:width="3dp" android:color="#E94560" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- État pressé -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3A1A2E" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- État normal -->
    <item>
        <shape>
            <solid android:color="#1E1E2E" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>

