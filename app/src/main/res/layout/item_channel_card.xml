<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte chaîne premium :
    - Logo grand format 16:9 en haut
    - Nom sur 2 lignes (wrap) en dessous
    - Catégorie en sous-titre
    - Contour rouge au focus D-Pad
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:stateListAnimator="@null">

    <!-- Logo 16:9 -->
    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="match_parent"
        android:layout_height="158dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_channel_logo" />

    <!-- Infos texte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:minHeight="62dp">

        <!-- Nom chaîne : 2 lignes max, texte qui wrap -->
        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp" />

        <!-- Catégorie / groupe -->
        <TextView
            android:id="@+id/channel_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

    </LinearLayout>

</LinearLayout>

