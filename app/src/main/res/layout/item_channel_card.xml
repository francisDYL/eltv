<?xml version="1.0" encoding="utf-8"?>
<!--
    Carte chaîne : logo dans conteneur surface, nom 2 lignes centré, focus D-Pad contour rouge
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="@drawable/card_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:stateListAnimator="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Conteneur logo : fond surface + padding intérieur, logo fitCenter -->
    <FrameLayout
        android:id="@+id/logo_container"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="10dp"
        android:background="@drawable/channel_logo_surface"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/content_desc_channel_logo" />

    </FrameLayout>

    <!-- Nom de la chaîne : 2 lignes, centré, wrap -->
    <TextView
        android:id="@+id/channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="36dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2" />

    <!-- Catégorie -->
    <TextView
        android:id="@+id/channel_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

</LinearLayout>

