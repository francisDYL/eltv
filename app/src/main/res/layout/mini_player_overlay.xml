<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay mini-player :
    - Positionné en bas à droite de l'écran (gravity=bottom|end)
    - Transparent pour le reste de l'interface
    - Visible uniquement quand un flux est en cours
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">

    <!-- Conteneur du mini-player -->
    <LinearLayout
        android:id="@+id/mini_player_container"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/mini_player_bg"
        android:elevation="16dp"
        android:visibility="gone"
        android:focusable="false">

        <!-- Aperçu vidéo 16:9 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/mini_player_view"
            android:layout_width="match_parent"
            android:layout_height="169dp"
            android:focusable="false"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <!-- Barre inférieure : nom + boutons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical"
            android:background="#1A000000">

            <!-- Nom de la chaîne -->
            <TextView
                android:id="@+id/mini_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Bouton plein écran -->
            <TextView
                android:id="@+id/mini_expand_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="⛶"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Plein écran" />

            <!-- Bouton stop -->
            <TextView
                android:id="@+id/mini_stop_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="■"
                android:textColor="#E94560"
                android:textSize="18sp"
                android:gravity="center"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Arrêter" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

