<resources>
    <!-- Thème principal de l'app -->
    <style name="Theme.ELTV" parent="Theme.Leanback">
        <item name="colorPrimary">@color/brand_midnight</item>
        <item name="colorPrimaryDark">@color/brand_midnight_dark</item>
        <item name="colorAccent">@color/accent_midnight</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Thème pour DetailsActivity -->
    <style name="Theme.ELTV.Details" parent="Theme.Leanback.Details">
        <item name="colorPrimary">@color/brand_midnight</item>
        <item name="colorAccent">@color/accent_midnight</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- Thème Splash Screen (Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/project_logo</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.ELTV</item>
    </style>

    <!-- Thème pour SettingsActivity (GuidedStep) -->
    <style name="Theme.ELTV.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="colorPrimary">@color/brand_midnight</item>
        <item name="colorAccent">@color/accent_midnight</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>